{
  "manifest_version": 3,
  "name": "Sonos at home",
  "version": "0.1.0",
  "description": "Send a web page's audio to a Sonos room, or stream this tab, through the Sonos service on this Mac.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8737/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sonos at home",
    "default_popup": "popup.html"
  },
  "key": ""
}
